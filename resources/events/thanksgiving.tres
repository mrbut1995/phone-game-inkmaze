[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/resources/level_data.gd" id="1_level"]
[ext_resource type="Resource" path="res://resources/levels/events/winter/level_1406.tres" id="2_level"]
[ext_resource type="Resource" path="res://resources/levels/events/winter/level_1407.tres" id="3_level"]
[ext_resource type="Resource" path="res://resources/levels/events/winter/level_1408.tres" id="4_level"]
[ext_resource type="Script" path="res://scripts/resources/event_reward.gd" id="5_reward"]
[ext_resource type="Script" path="res://scripts/resources/event_data.gd" id="6_event"]
[ext_resource type="Resource" path="res://resources/events/themes/thanksgiving.tres" id="7_theme"]

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("5_reward")
amount = 350
label_key = &"STR_EVENT_THANKSGIVING_REWARD_1"

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("5_reward")
amount = 150
label_key = &"STR_EVENT_THANKSGIVING_REWARD_2"

[resource]
script = ExtResource("6_event")
id = &"thanksgiving"
type = 1
theme = ExtResource("7_theme")
sort_order = 25
chip_key = &"STR_EVENT_THANKSGIVING_CHIP"
title_key_1 = &"STR_EVENT_THANKSGIVING_TITLE_1"
title_key_2 = &"STR_EVENT_THANKSGIVING_TITLE_2"
