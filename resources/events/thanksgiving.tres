sub_key_2 = &"STR_EVENT_THANKSGIVING_SUB_2"
unit_key = &"STR_EVENT_UNIT_LEVELS"
cta_key = &"STR_EVENT_CTA_CONTINUE"
start_utc = "2026-11-23T00:00:00Z"
end_utc = "2026-12-01T00:00:00Z"
levels = Array[ExtResource("1_level")]([ExtResource("2_level"), ExtResource("3_level"), ExtResource("4_level")])
