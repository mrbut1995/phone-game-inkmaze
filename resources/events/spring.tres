[ext_resource type="Resource" path="res://resources/levels/events/tomb/level_1201.tres" id="3_level"]
[ext_resource type="Resource" path="res://resources/levels/events/tomb/level_1202.tres" id="4_level"]
[ext_resource type="Script" path="res://scripts/data/event_reward.gd" id="5_reward"]
[ext_resource type="Script" path="res://scripts/data/event_data.gd" id="6_event"]
[ext_resource type="Resource" path="res://resources/events/themes/spring.tres" id="7_theme"]

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("5_reward")
