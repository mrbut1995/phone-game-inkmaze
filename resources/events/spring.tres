[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("5_reward")
amount = 150
label_key = &"STR_EVENT_SPRING_REWARD_2"

[resource]
script = ExtResource("6_event")
id = &"spring"
type = 0
theme = ExtResource("7_theme")
sort_order = 65
chip_key = &"STR_EVENT_SPRING_CHIP"
title_key_1 = &"STR_EVENT_SPRING_TITLE_1"
title_key_2 = &"STR_EVENT_SPRING_TITLE_2"
