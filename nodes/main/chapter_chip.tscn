"update": 0,
"values": [Vector2(1, 1), Vector2(1.3, 1.3), Vector2(1, 1)]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_chip"]
_data = {
&"RESET": SubResource("Animation_reset"),
&"next_hint": SubResource("Animation_hint")
}

[node name="ChapterChip" type="PanelContainer" node_paths=PackedStringArray("lbl_title", "btn_prev", "btn_next", "anim")]
