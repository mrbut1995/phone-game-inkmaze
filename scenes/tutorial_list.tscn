[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/base.tscn" id="1_base"]
[ext_resource type="Theme" path="res://resources/settings/theme_default.tres" id="2_theme_text"]
[ext_resource type="Script" path="res://scripts/ui/screens/tutorial_list.gd" id="3_script"]
[ext_resource type="PackedScene" path="res://scenes/layout/portrait/tutorial_list.tscn" id="4_portrait"]
[ext_resource type="PackedScene" path="res://scenes/layout/landscape/tutorial_list.tscn" id="5_landscape"]

[node name="Control" type="Control" instance=ExtResource("1_base")]
theme = ExtResource("2_theme_text")
script = ExtResource("3_script")

[node name="Portrait" parent="." index="1" instance=ExtResource("4_portrait")]
layout_mode = 1

[node name="Landscape" parent="." index="2" instance=ExtResource("5_landscape")]
layout_mode = 1

[connection signal="pressed" from="Portrait/TopBar/Back" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Portrait/Paper/ModeScroll/ModeList/BtnFirstTime" to="." method="_on_select_tutorial" binds= ["first_time"]]
